APP_ENV=development
APP_DEBUG=true
SECRET_KEY=change-me-in-production
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/alert_intelligence
DATABASE_POOL_SIZE=20
REDIS_URL=redis://localhost:6379/0
ANTHROPIC_API_KEY=your-key-here
AZURE_AD_TENANT_ID=
AZURE_AD_CLIENT_ID=
AZURE_AD_CLIENT_SECRET=
AZURE_AD_REDIRECT_URI=http://localhost:8000/auth/callback
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2
GUNICORN_WORKERS=4
LOG_LEVEL=info

# SMTP2GO Email Configuration (Sending)
SMTP_SERVER=mail.smtp2go.com
SMTP_PORT=587
SMTP_USERNAME=your-smtp2go-username
SMTP_PASSWORD=your-smtp2go-password
SMTP_FROM_EMAIL=LSAC_Site_Checks@outlook.com

# IMAP Email Configuration (Reading)
IMAP_SERVER=outlook.office365.com
IMAP_PORT=993
IMAP_USERNAME=LSAC_Site_Checks@outlook.com
IMAP_PASSWORD=your-outlook-password
IMAP_FOLDER=INBOX
EMAIL_POLL_INTERVAL=60
